# JanNetra Backend Configuration (Production/Local)

# Core API Settings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# External Services
NEWSAPI_KEY=your_newsapi_key

# Database (MongoDB Atlas for Production, local for testing)
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=governance_db

# NVIDIA Vision API (Required for Citizen Complaint Image Analysis)
NVIDIA_API_KEY=your_nvidia_api_key

# JWT Authentication (Primary Authentication)
JWT_SECRET_KEY=DEV_SECRET_KEY_FOR_JANNETRA_CHANGE_IN_PROD
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Authentication (Optional - for Google Sign-In and Firebase Phone OTP)
# Paste service account JSON directly as a single line string or place serviceAccountKey.json in backend/app/
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}

# Port Binding (Railway handles this in production)
# PORT=8000

